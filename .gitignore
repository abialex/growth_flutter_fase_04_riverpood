migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Claude Code local settings
.claude/

# Local project rules doc (not tracked)
/doc/

# .vscode/launch.json es autogenerado por el editor (rutas de Windows) —
# no aporta valor versionado, cada quien genera el suyo.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.kotlin/
.pub-cache/
.pub/
/build/
/coverage/

# Libraries should not include pubspec.lock, per
# https://dart.dev/guides/libraries/private-files#pubspeclock — example/
# is an app, así que ese sí versiona el suyo.
/pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
